PORT=8000
# Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK=gemini-3-flash

# Turso Cloud Database (leave empty to use local database/codm.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
